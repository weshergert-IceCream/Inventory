generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InventoryTransactionType {
  RECEIPT
  COUNT_ADJUSTMENT
  MANUAL_ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN_TO_SUPPLIER
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum StockCountStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DeliveryStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum UserRole {
  OWNER
  MANAGER
  STAFF
}

model ProductCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Manufacturer {
  id          String    @id @default(cuid())
  name        String    @unique
  contactName String?
  phone       String?
  email       String?
  website     String?
  notes       String?
  active      Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Unit {
  id           String            @id @default(cuid())
  name         String            @unique
  abbreviation String            @unique
  unitType     String
  products     Product[]         @relation("InventoryUnit")
  supplierPack SupplierProduct[] @relation("PurchaseUnit")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Supplier {
  id                 String            @id @default(cuid())
  name               String            @unique
  contactName        String?
  email              String?
  phone              String?
  website            String?
  accountNumber      String?
  orderMethod        String?
  orderDay           String?
  leadTimeDays       Int?
  minimumOrderAmount Decimal?          @db.Decimal(10, 2)
  deliveryNotes      String?
  active             Boolean           @default(true)
  supplierProducts   SupplierProduct[]
  purchaseOrders     PurchaseOrder[]
  deliveries         Delivery[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Product {
  id                String                 @id @default(cuid())
  name              String
  sku               String?                @unique
  categoryId        String
  manufacturerId    String?
  inventoryUnitId   String
  parLevel          Decimal                @default(0) @db.Decimal(12, 3)
  reorderPoint      Decimal                @default(0) @db.Decimal(12, 3)
  reorderQuantity   Decimal                @default(0) @db.Decimal(12, 3)
  currentCost       Decimal                @default(0) @db.Decimal(12, 4)
  trackInventory    Boolean                @default(true)
  active            Boolean                @default(true)
  notes             String?
  category          ProductCategory        @relation(fields: [categoryId], references: [id])
  manufacturer      Manufacturer?          @relation(fields: [manufacturerId], references: [id])
  inventoryUnit     Unit                    @relation("InventoryUnit", fields: [inventoryUnitId], references: [id])
  supplierProducts  SupplierProduct[]
  transactions      InventoryTransaction[]
  stockCountItems   StockCountItem[]
  purchaseOrderItems PurchaseOrderItem[]
  deliveryItems     DeliveryItem[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([categoryId])
  @@index([manufacturerId])
  @@index([name])
}

model SupplierProduct {
  id                      String                 @id @default(cuid())
  supplierId              String
  productId               String
  supplierSku             String?
  supplierDescription     String?
  purchaseUnitId          String
  quantityPerPurchaseUnit Decimal                @db.Decimal(12, 3)
  purchasePrice           Decimal                @db.Decimal(12, 2)
  minimumOrder            Decimal                @default(1) @db.Decimal(12, 3)
  preferred               Boolean                @default(false)
  active                  Boolean                @default(true)
  supplier                Supplier               @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product                 Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseUnit            Unit                   @relation("PurchaseUnit", fields: [purchaseUnitId], references: [id])
  priceHistory            SupplierPriceHistory[]
  purchaseOrderItems      PurchaseOrderItem[]
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@unique([supplierId, productId, supplierSku])
  @@index([productId])
  @@index([supplierId])
}

model SupplierPriceHistory {
  id                String          @id @default(cuid())
  supplierProductId String
  oldPrice          Decimal?        @db.Decimal(12, 2)
  newPrice          Decimal         @db.Decimal(12, 2)
  effectiveDate     DateTime        @default(now())
  source            String?
  supplierProduct   SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())

  @@index([supplierProductId, effectiveDate])
}

model Location {
  id           String                 @id @default(cuid())
  name         String                 @unique
  locationType String?
  active       Boolean                @default(true)
  sortOrder    Int                    @default(0)
  transactions InventoryTransaction[]
  stockCounts  StockCount[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
}

model InventoryTransaction {
  id              String                   @id @default(cuid())
  productId       String
  locationId      String
  transactionType InventoryTransactionType
  quantity        Decimal                  @db.Decimal(12, 3)
  unitCost        Decimal?                 @db.Decimal(12, 4)
  referenceType   String?
  referenceId     String?
  userId          String?
  notes           String?
  transactionDate DateTime                 @default(now())
  product         Product                  @relation(fields: [productId], references: [id])
  location        Location                 @relation(fields: [locationId], references: [id])
  user            User?                    @relation(fields: [userId], references: [id])
  createdAt       DateTime                 @default(now())

  @@index([productId, transactionDate])
  @@index([locationId, transactionDate])
  @@index([referenceType, referenceId])
}

model StockCount {
  id          String           @id @default(cuid())
  locationId  String
  countDate   DateTime         @default(now())
  status      StockCountStatus @default(DRAFT)
  createdById String?
  completedById String?
  completedAt DateTime?
  notes       String?
  location    Location         @relation(fields: [locationId], references: [id])
  createdBy   User?            @relation("CreatedStockCounts", fields: [createdById], references: [id])
  completedBy User?            @relation("CompletedStockCounts", fields: [completedById], references: [id])
  items       StockCountItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([locationId, countDate])
}

model StockCountItem {
  id               String     @id @default(cuid())
  stockCountId     String
  productId        String
  expectedQuantity Decimal    @db.Decimal(12, 3)
  countedQuantity  Decimal    @db.Decimal(12, 3)
  varianceQuantity Decimal    @db.Decimal(12, 3)
  unitCost         Decimal    @db.Decimal(12, 4)
  varianceValue    Decimal    @db.Decimal(12, 2)
  notes            String?
  stockCount       StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  product          Product    @relation(fields: [productId], references: [id])

  @@unique([stockCountId, productId])
}

model PurchaseOrder {
  id                   String              @id @default(cuid())
  poNumber             String              @unique
  supplierId           String
  status               PurchaseOrderStatus @default(DRAFT)
  orderDate            DateTime            @default(now())
  expectedDeliveryDate DateTime?
  submittedDate        DateTime?
  createdById          String?
  subtotal             Decimal             @default(0) @db.Decimal(12, 2)
  tax                  Decimal             @default(0) @db.Decimal(12, 2)
  total                Decimal             @default(0) @db.Decimal(12, 2)
  supplierConfirmation String?
  notes                String?
  supplier             Supplier            @relation(fields: [supplierId], references: [id])
  createdBy            User?               @relation(fields: [createdById], references: [id])
  items                PurchaseOrderItem[]
  deliveries           Delivery[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([supplierId, status])
}

model PurchaseOrderItem {
  id                      String          @id @default(cuid())
  purchaseOrderId         String
  productId               String
  supplierProductId       String?
  quantityOrdered         Decimal         @db.Decimal(12, 3)
  purchaseUnitLabel       String
  quantityPerUnit         Decimal         @db.Decimal(12, 3)
  unitPrice               Decimal         @db.Decimal(12, 2)
  quantityReceived        Decimal         @default(0) @db.Decimal(12, 3)
  lineTotal               Decimal         @db.Decimal(12, 2)
  notes                   String?
  purchaseOrder           PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product                 Product         @relation(fields: [productId], references: [id])
  supplierProduct         SupplierProduct? @relation(fields: [supplierProductId], references: [id])
  deliveryItems           DeliveryItem[]

  @@index([purchaseOrderId])
  @@index([productId])
}

model Delivery {
  id              String         @id @default(cuid())
  purchaseOrderId String?
  supplierId      String
  deliveryDate    DateTime       @default(now())
  invoiceNumber   String?
  invoiceTotal    Decimal?       @db.Decimal(12, 2)
  receivedById    String?
  status          DeliveryStatus @default(IN_PROGRESS)
  notes           String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  receivedBy      User?          @relation(fields: [receivedById], references: [id])
  items           DeliveryItem[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model DeliveryItem {
  id                        String             @id @default(cuid())
  deliveryId                String
  purchaseOrderItemId       String?
  productId                 String
  locationId                String?
  quantityReceived          Decimal            @db.Decimal(12, 3)
  purchaseUnitLabel         String
  inventoryQuantityReceived Decimal            @db.Decimal(12, 3)
  actualUnitCost            Decimal?           @db.Decimal(12, 4)
  damagedQuantity           Decimal            @default(0) @db.Decimal(12, 3)
  notes                     String?
  delivery                  Delivery           @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  purchaseOrderItem         PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  product                   Product            @relation(fields: [productId], references: [id])

  @@index([deliveryId])
}

model User {
  id                   String                 @id @default(cuid())
  name                 String
  email                String                 @unique
  passwordHash         String?
  role                 UserRole               @default(STAFF)
  active               Boolean                @default(true)
  lastLogin            DateTime?
  transactions         InventoryTransaction[]
  createdStockCounts   StockCount[]           @relation("CreatedStockCounts")
  completedStockCounts StockCount[]           @relation("CompletedStockCounts")
  purchaseOrders       PurchaseOrder[]
  deliveries           Delivery[]
  auditLogs            AuditLog[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  beforeJson Json?
  afterJson  Json?
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
